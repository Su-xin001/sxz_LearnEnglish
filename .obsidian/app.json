{
  "newLinkFormat": "relative",
  "useMarkdownLinks": true,
  "foldHeading": true,
  "foldIndent": true,
  "tabSize": 2,
  "readableLineLength": true,
  "strictLineBreaks": false,
  "showLineNumber": true,
  "livePreview": true,
  "propertiesInDocument": "visible",
  "showInlineTitle": true,
  "spellcheck": true,
  "spellcheckLanguages": [
    "en-US",
    "en-GB"
  ],
  "autoPairBrackets": true,
  "autoPairMarkdown": true,
  "showUnsupportedFiles": true,
  "attachmentFolderPath": "08-Resources/Attachments",
  "alwaysUpdateLinks": true,
  "newFileLocation": "current",
  "newFileTemplate": "09-Templates/Daily-Note-Template",
  "promptDelete": false,
  "userIgnoreFilters": [
    "09-Templates/",
    "10-Documentation/"
  ],
  "mobilePullAction": "daily-notes",
  "mobileQuickRibbonItem": "review:review",
  "mobileToolbarCommands": [
    "editor:insert-wikilink",
    "editor:insert-embed",
    "editor:insert-tag",
    "editor:attach-file",
    "editor:set-heading",
    "editor:toggle-bold",
    "editor:toggle-italics",
    "editor:toggle-strikethrough",
    "editor:toggle-highlight",
    "editor:toggle-code",
    "editor:toggle-blockquote",
    "editor:insert-link",
    "editor:insert-table",
    "editor:insert-horizontal-rule",
    "editor:unfold-all"
  ],
  "defaultViewMode": "preview",
  "editorStatus": true,
  "pdfExportSettings": {
    "includeName": true,
    "pageSize": "A4",
    "landscape": false,
    "margin": "0"
  },
  "vimMode": false
}