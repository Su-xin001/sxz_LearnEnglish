{
  "corePlugins": {
    "file-recovery": true,
    "outline": true,
    "page-preview": true,
    "word-count": true,
    "sync": false,
    "publish": false,
    "daily-notes": true,
    "templates": true,
    "note-composer": true,
    "command-palette": true,
    "open-in-default-app": true,
    "file-explorer": true,
    "search": true,
    "global-search": true,
    "switcher": true,
    "graph": true,
    "backlinks": true,
    "outgoing-links": true,
    "tag-pane": true,
    "properties": true,
    "markdown-importer": true
  },
  "communityPlugins": {
    "required": [
      "hi-words",
      "obsidian-spaced-repetition",
      "ob-english-learner",
      "obsidian-language-learner",
      "templater-obsidian",
      "obsidian-git",
      "various-complements"
    ],
    "recommended": [
      "dictionary",
      "text-generator",
      "highlightr",
      "excel-to-markdown-table",
      "obsidian-cursor-location"
    ],
    "optional": [
      "rss-dashboard",
      "media-extended"
    ]
  },
  "pluginConfigurations": {
    "hi-words": {
      "enableHover": true,
      "highlightColor": "#ffeb3b",
      "autoLookup": false,
      "showPhonetic": true,
      "vocabularyFolder": "2_Vocabulary/00_Alphabet",
      "enableStatusBar": true
    },
    "obsidian-spaced-repetition": {
      "flashcardFolder": "4_Review/02_Cards",
      "scheduleFolder": "4_Review/01_Schedule",
      "enableNoteFields": true,
      "algorithm": "SM-2",
      "newCardsPerDay": 20,
      "maxReviewsPerDay": 100
    },
    "templater-obsidian": {
      "templateFolder": "5_Resources/01_Templates",
      "enableAutoUpdate": true,
      "enableFunctions": true
    },
    "obsidian-git": {
      "autoSaveInterval": 30,
      "commitMessage": "Auto backup: {{date}}",
      "enableAutoBackup": true
    }
  }
}
